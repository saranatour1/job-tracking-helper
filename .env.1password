# 1Password secret references, not secrets. Safe to commit.
# Each line points at a field of the "job-tracking-helper" item in your Private vault.
# `vp run secrets:push` resolves them with `op run` and sends them to Convex.
AUTH_GOOGLE_CLIENT_ID=op://Private/job-tracking-helper/AUTH_GOOGLE_CLIENT_ID
AUTH_GOOGLE_CLIENT_SECRET=op://Private/job-tracking-helper/AUTH_GOOGLE_CLIENT_SECRET
AUTH_GITHUB_CLIENT_ID=op://Private/job-tracking-helper/AUTH_GITHUB_CLIENT_ID
AUTH_GITHUB_CLIENT_SECRET=op://Private/job-tracking-helper/AUTH_GITHUB_CLIENT_SECRET
