{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-tracking-helper",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "ye.saranatour.dev", "custom_domain": true }],
  // Files in public/ skip the Worker, and AI crawlers reading llms.txt have to reach it to be recorded.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/*.txt"] },
  // Role pages and their preview images, per IP. Any number works as long as this account's other
  // Workers don't use it. A crawler that goes over gets a 429 and slows down.
  "ratelimits": [
    { "name": "ROLE_PAGES", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issue_detection": {
      "enabled": true,
    },
  },
}
